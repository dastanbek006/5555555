datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid())
  firstName    String
  lastName     String
  phone        String    @unique
  passwordHash String
  avatarUrl    String?
  role         String    @default("CLIENT") // CLIENT, PARTNER, ADMIN
  partner      Partner?
  products     Product[]
  orders       Order[]   @relation("UserOrders")
  assignedOrders Order[] @relation("PartnerOrders")
  createdAt    DateTime  @default(now())
}

model Partner {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level     String   @default("STANDARD") // STANDARD, PRO, VIP
  status    String   @default("PENDING")  // PENDING, APPROVED, REJECTED
  alerts    Alert[]
  createdAt DateTime @default(now())
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  imageUrl String
  services Service[]
  products Product[]
}

model Service {
  id          String         @id @default(uuid())
  categoryId  String
  category    Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  imageUrl    String
  isActive    Boolean        @default(true)
  fields      ServiceField[]
  createdAt   DateTime       @default(now())
}

model ServiceField {
  id        String   @id @default(uuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  label     String
  fieldType String   @default("TEXT") // TEXT, FILE, NUMBER, SELECT
  required  Boolean  @default(true)
}

model Product {
  id          String      @id @default(uuid())
  partnerId   String
  partner     User        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  price       Float
  stock       Int         @default(0)
  images      String      // JSON stringified array of max 3 image URLs
  isActive    Boolean     @default(true)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation("UserOrders", fields: [userId], references: [id])
  partnerId   String?
  partner     User?       @relation("PartnerOrders", fields: [partnerId], references: [id])
  type        String      @default("PRODUCT") // SERVICE, PRODUCT
  status      String      @default("PENDING") // PENDING, REVIEWING, ON_WAY, DELIVERED
  totalPrice  Float
  files       OrderFile[]
  items       OrderItem[]
  alerts      Alert[]
  createdAt   DateTime    @default(now())
  deliveredAt DateTime?
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model OrderFile {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fileUrl   String
  fileType  String
  isDeleted Boolean  @default(false)
}

model Alert {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime @default(now())
}

model Banner {
  id       String  @id @default(uuid())
  imageUrl String
  text     String
  isActive Boolean @default(true)
}
